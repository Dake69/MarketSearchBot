# Search defaults (used when searches.yaml does not exist)
FB_MARKETPLACE_LOCATION=Brno
FB_MARKETPLACE_LAT=
FB_MARKETPLACE_LON=
FB_MARKETPLACE_RADIUS_KM=50
SEARCH_QUERY=
MIN_PRICE=
MAX_PRICE=
FB_CATEGORY_ID=

SEARCHES_FILE=searches.yaml
POLL_INTERVAL_SECONDS=300
SEND_EXISTING_ON_FIRST_RUN=false
MARKETPLACE_MODE=auto
HEADLESS=true
BROWSER_LOCALE=en-US
HTTP_TIMEOUT_SECONDS=30
PAGE_TIMEOUT_SECONDS=45000
MAX_LISTINGS_PER_SEARCH=60
ALL_CATEGORIES_PER_CYCLE=17
LISTING_RETENTION_DAYS=3
JITTER_SECONDS=5

DATABASE_PATH=data/marketplace.db
# Set automatically by Heroku Postgres. When present, it takes priority over DATABASE_PATH.
DATABASE_URL=
BROWSER_PROFILE_PATH=data/browser-profile
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LOG_LEVEL=INFO
